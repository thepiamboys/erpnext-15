{
  "doctype": "DocType",
  "name": "Project Freight Manifest",
  "module": "Projects",
  "custom": 0,
  "istable": 1,
  "is_submittable": 0,
  "autoname": "",
  "editable_grid": 1,
  "track_changes": 1,
  "fields": [
    {"fieldname": "container_no", "label": "Container No", "fieldtype": "Data"},
    {"fieldname": "container_type", "label": "Container Type", "fieldtype": "Select", "options": "20GP\n40GP\n40HC\n45HC\nLCL\nLoose\nOther"},
    {"fieldname": "seal_no", "label": "Seal No", "fieldtype": "Data"},
    {"fieldname": "package_count", "label": "Package Count", "fieldtype": "Int"},
    {"fieldname": "package_uom", "label": "Package UOM", "fieldtype": "Select", "options": "CTN\nPKG\nBAG\nDRUM\nPALLET\nOTHER"},
    {"fieldname": "gross_weight_kg", "label": "Gross Weight (KG)", "fieldtype": "Float"},
    {"fieldname": "volume_cbm", "label": "Volume (CBM)", "fieldtype": "Float"},
    {"fieldname": "commodity", "label": "Commodity", "fieldtype": "Small Text"},
    {"fieldname": "hs_code", "label": "HS Code", "fieldtype": "Data"},
    {"fieldname": "dangerous_goods", "label": "Dangerous Goods", "fieldtype": "Check"},
    {"fieldname": "remarks", "label": "Remarks", "fieldtype": "Small Text"}
  ],
  "permissions": [
    {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1},
    {"role": "Projects User", "read": 1, "write": 1, "create": 1}
  ]
}
